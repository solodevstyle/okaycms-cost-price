{
    "version": "1.0.1",
    "modifications": {
      "backend": [
        {
          "file": "products.tpl",
          "changes": [
            {
              "find": "{if $category}",
              "appendBefore": "{if $manager->permissions && in_array('sdm_cost_price', $manager->permissions)}{literal}<style>.okay_list .okay_list_name {width: calc(100% - 820px);}</style>{/literal}{/if}"
            },
            {
              "find": "<div class=\"okay_list_heading okay_list_price",
              "appendBefore": "{if $manager->permissions && in_array('sdm_cost_price', $manager->permissions)}<div class=\"okay_list_heading okay_list_price\">Собівартість</div>{/if}"
            },
            {
              "find": "<div class=\"okay_list_boding okay_list_price",
              "appendBefore": "{if $manager->permissions && in_array('sdm_cost_price', $manager->permissions)}<div class=\"okay_list_boding okay_list_price\"><div class=\"input-group\">{$this_variants = []}{foreach $product->variants as $pv}{$this_variants[$pv->id] = $pv->id}{/foreach}{if !empty($variant) && !empty($this_variants[$variant->id]) && $variant->id != $product->variants[0]->id}<input class=\"form-control{if $variant->cost_price > $variant->price} text_warning{/if}\" type=\"text\" name=\"cost_price[{$variant->id}]\" value=\"{$variant->cost_price}\"><span class=\"input-group-addon\">{if isset($currencies[$variant->currency_id])}{$currencies[$variant->currency_id]->code|escape}{/if}</span>{else}<input class=\"form-control{if $product->variants[0]->cost_price > $product->variants[0]->price} text_warning{/if}\" type=\"text\" name=\"cost_price[{$product->variants[0]->id}]\" value=\"{$product->variants[0]->cost_price}\"><span class=\"input-group-addon\">{if isset($currencies[$product->variants[0]->currency_id])}{$currencies[$product->variants[0]->currency_id]->code|escape}{/if}</span>{/if}</div></div>{/if}"
            }
          ]
        },
        {
          "file": "product.tpl",
          "changes": [
            {
              "find": "{foreach $product_variants as $variant}",
              "childrenFind": "<div class=\"okay_list_boding variants_item_price",
              "appendBefore": "{if $manager->permissions && in_array('sdm_cost_price', $manager->permissions)}<div class=\"okay_list_boding variants_item_price\"><div class=\"heading_label\">Собівартість</div><input class=\"variant_input\" name=\"variants[cost_price][]\" type=\"text\" value=\"{$variant->cost_price|escape}\"></div>{/if}"
            },
            {
              "find": "<div class=\"okay_list_body_item variants_list_item fn_new_row_variant",
              "childrenFind": "<div class=\"okay_list_boding variants_item_price",
              "appendBefore": "{if $manager->permissions && in_array('sdm_cost_price', $manager->permissions)}<div class=\"okay_list_boding variants_item_price\"><div class=\"heading_label\">Собівартість</div><input class=\"variant_input\" name=\"variants[cost_price][]\" type=\"text\" value=\"\"></div>{/if}"
            }
          ]
        },
        {
          "file": "reportstats.tpl",
          "changes": [
            {
              "find": "<div class=\"okay_list_heading okay_list_reportstats_total",
              "appendAfter": "{if $manager->permissions && in_array('sdm_cost_price', $manager->permissions)}<div class=\"okay_list_heading okay_list_reportstats_total\">Дохід</div>{/if}"
            },
            {
              "find": "<div class=\"okay_list_boding okay_list_reportstats_total",
              "appendAfter": "{if $manager->permissions && in_array('sdm_cost_price', $manager->permissions)}<div class=\"okay_list_boding okay_list_reportstats_total\">{$purchase->profit|escape} {$currency->sign|escape}</div>{/if}"
            },
            {
              "find": "{assign 'total_amount' 0}",
              "appendAfter": "{if $manager->permissions && in_array('sdm_cost_price', $manager->permissions)}{assign 'total_profit_sum' 0}{/if}"
            },
            {
              "find": "{assign var='total_summ'  value=$total_summ+$purchase->sum_price}",
              "appendAfter": "{if $manager->permissions && in_array('sdm_cost_price', $manager->permissions)}{assign var='total_profit_sum'  value=$total_profit_sum+$purchase->profit}{/if}"
            },
            {
              "find": "{$btr->general_total|escape}",
              "closestFind": "div class=\"col-lg-12 col-md-12",
              "appendAfter": "{if $manager->permissions && in_array('sdm_cost_price', $manager->permissions)}<div class=\"col-lg-12 col-md-12\"><div class=\"text_dark text_500 text-xs-right mr-1 mt-h\"><div class=\"h5\">Дохід {$total_profit_sum|string_format:'%.2f'} {$currency->sign|escape}  <span class=\"text_grey\">({$total_amount}  {$btr->reportstats_units})</span></div></div></div>{/if}"
            }
          ]
        }
      ]
    }
  }
